# ── Supabase ──────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key
# Scaling note: the backend talks to Supabase via the PostgREST client
# (supabase-py over httpx) using SUPABASE_URL — it does NOT open direct
# Postgres connections, so there is no SQLAlchemy/asyncpg pool to size.
# If a direct-Postgres path is ever added (DATABASE_URL), it MUST use the
# Supabase transaction pooler host (port 6543, ...pooler.supabase.com),
# never the direct connection (port 5432) — the direct connection limit
# (~60-100 on Pro) saturates fast at 1,000+ merchants.

# ── Privy authentication ──────────────────────────────────────
# DUM Club uses Privy for sign-in (email OTP + Google OAuth) and
# auto-provisions Solana embedded wallets for every signed-in user.
# Both env vars below MUST be set to the SAME app ID — frontend and
# backend share a Privy app. If they drift, the backend's JWKS
# verification rejects every token the frontend mints with
# "Token audience mismatch" (HTTP 401 on every authenticated call).
#
# Production app: DUM.CLUB (cmozwqkt600ho0dldrbcr6rwq)
# Set via Vercel (frontend) and Railway (backend) project env vars.
# Local dev: use the Privy dashboard's "development" app or your own
# tenant — never share a production app ID with a dev environment.
NEXT_PUBLIC_PRIVY_APP_ID=                  # frontend (Vercel) — public, inlined into client bundle
PRIVY_APP_ID=                              # backend (Railway) — used by JWKS fetch + token audience check

# ── Solana ────────────────────────────────────────────────────
NEXT_PUBLIC_SOLANA_NETWORK=devnet          # mainnet-beta for prod
NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_RPC_URL=                # frontend Connection RPC (defaults to NEXT_PUBLIC_SOLANA_RPC)

# Backend Solana RPC + treasury (used by /api/dum/swap and
# /api/checkout/sol-quote, /api/checkout/sol-confirm).
SOLANA_RPC_URL=https://api.devnet.solana.com   # use a paid RPC in prod
DUM_TREASURY_WALLET=                       # base58 — receives SOL from buyers
DUM_TREASURY_KEYPAIR=                      # base58 secret string (NOT a JSON array)
DUM_MINT=                                  # SPL token mint address
DUM_SOL_RATE=1000                          # 1 SOL = N DUM Points (swap rate)

# ── Solana wallet checkout (Phase 0B/1, behind feature flag) ──
# Buyer-side dual-rail payments. Stripe stays on for everyone; SOL
# checkout shows up only when NEXT_PUBLIC_ENABLE_SOL_CHECKOUT=true
# AND DUM_TREASURY_WALLET is set on the backend.
NEXT_PUBLIC_ENABLE_SOL_CHECKOUT=false      # frontend feature flag
SOL_CHECKOUT_QUOTE_HMAC_SECRET=            # required when SOL checkout is enabled
SOL_PRICE_ORACLE=coingecko                 # USD/SOL oracle (currently coingecko-only)
SOL_PRICE_USD_FALLBACK=150                 # fallback SOL/USD price if oracle is down

# ── Ollama ────────────────────────────────────────────────────
OLLAMA_MODEL=llama3                        # or mistral, phi3, etc.
OLLAMA_HOST=http://localhost:11434

# ── App ───────────────────────────────────────────────────────
JWT_SECRET=change-me-to-something-long-and-random
ENVIRONMENT=development

# ── Stripe Connect (Merchant Payouts) ────────────────────────
STRIPE_CONNECT_CLIENT_ID=                      # Stripe Connect platform client ID

# ── Square OAuth (POS Integration) ──────────────────────────
SQUARE_APPLICATION_ID=                         # Square app ID
SQUARE_APPLICATION_SECRET=                     # Square app secret
SQUARE_ENVIRONMENT=sandbox                     # sandbox or production

# ── Frontend URL (for OAuth callbacks) ──────────────────────
FRONTEND_URL=http://localhost:3000

# ── Off-Platform Demand Capture ──────────────────────────────
GOOGLE_MAPS_API_KEY=                           # Google Places API key (optional)
GOOGLE_MAPS_SEARCH_RADIUS=10000                # Search radius in meters
EXTERNAL_LOCAL_SEARCH_ENABLED=false            # Enable external place discovery
OFF_PLATFORM_RECEIPT_REWARDS_ENABLED=false     # Enable proof-of-purchase rewards
MERCHANT_OUTREACH_QUEUE_ENABLED=false          # Enable merchant outreach queue
MERCHANT_OUTREACH_SEND_ENABLED=false           # Enable live outreach sending (email/SMS)

# ── AWS IVS Real-Time (live streaming) ────────────────────────
# WebRTC live commerce via AWS IVS Real-Time. The code path is fully
# built (services/ivs_realtime.py, api/routes/ivs.py, frontend
# IVSStageHost/Viewer). It stays dormant until BOTH:
#   1. ENABLE_IVS_REALTIME_BACKEND=true on Railway, AND
#   2. NEXT_PUBLIC_ENABLE_IVS_REALTIME=true on Vercel.
# Activation runbook (IAM policy, smoke tests, rollback): see
# docs/IVS_ACTIVATION.md. Setting the backend env without the frontend
# flag is a safe no-op — nothing in the UI calls /api/ivs/* yet.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
ENABLE_IVS_REALTIME_BACKEND=false
NEXT_PUBLIC_ENABLE_IVS_REALTIME=false
